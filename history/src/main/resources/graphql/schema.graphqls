type AppointmentHistory {
    id: ID!
    eventId: String!
    eventType: String!
    eventVersion: Int!
    occurredAt: String!
    appointmentId: ID!
    patientUsername: String!
    doctorUsername: String!
    appointmentDate: String!
    status: String!
}

type Query {
    # O paciente autenticado consulta somente o próprio histórico
    getMyHistory: [AppointmentHistory!]!

    # O paciente autenticado consulta somente suas consultas futuras
    getMyFutureHistory: [AppointmentHistory!]!

    # Médicos e enfermeiros consultam um paciente específico
    getPatientHistory(
        patientUsername: String!
    ): [AppointmentHistory!]!

    # Médicos e enfermeiros consultam consultas futuras de um paciente
    getPatientFutureHistory(
        patientUsername: String!
    ): [AppointmentHistory!]!

    # Médicos e enfermeiros consultam todos os registros
    getAllHistory: [AppointmentHistory!]!
}