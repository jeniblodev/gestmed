      "item": [
        {
          "name": "01 - Enfermeiro cria uma consulta",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const base = Date.now() + (30 * 24 * 60 * 60 * 1000) + Math.floor(Math.random() * 3600000);",
                  "const futureDate = new Date(base).toISOString().slice(0, 19);",
                  "const updatedDate = new Date(base + (24 * 60 * 60 * 1000)).toISOString().slice(0, 19);",
                  "const pastDate = new Date(Date.now() - (24 * 60 * 60 * 1000)).toISOString().slice(0, 19);",
                  "pm.collectionVariables.set('future_date', futureDate);",
                  "pm.collectionVariables.set('updated_date', updatedDate);",
                  "pm.collectionVariables.set('past_date', pastDate);",
                  "pm.collectionVariables.unset('appointment_id');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Consulta criada com sucesso', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.errors).to.be.undefined;",
                  "    pm.expect(json.data.createAppointment.status).to.eql('SCHEDULED');",
                  "    pm.expect(json.data.createAppointment.patientUsername).to.eql(pm.environment.get('patient_username'));",
                  "    pm.collectionVariables.set('appointment_id', String(json.data.createAppointment.id));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{nurse_username}}",
                  "type": "string"
